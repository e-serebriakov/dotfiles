;; Babashka uses this directory as a classpath root through `:paths ["."]`.
;; engine.clj supplies namespace engine. generators/delta.clj supplies generators.delta.
;; From this directory, run tasks with `bb <task>`.
{:paths ["."]
 :tasks
 {test {:doc "Run the test suite"
        :requires ([clojure.test :as t] [generate-test])
        :task (let [{:keys [fail error]} (t/run-tests 'generate-test)]
                (when (pos? (+ fail error)) (System/exit 1)))}}}
