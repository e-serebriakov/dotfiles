{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "Ergo Light — tool-agnostic design tokens. Layer 1 (primitive ramps) + Layer 2 (semantic roles). No tool knows about this file directly; adapters in theme/generate.py translate semantic tokens into per-tool theme files. Edit here, then run theme/generate.py and commit the generated outputs. Direction: calm neutral paper (one shared bg for editor/terminal/zellij), soft ink ~10:1, muted 'dusty' accents (low chroma, uniform ~4.7:1 weight), very soft background tints.",

  "primitive": {
    "$description": "Layer 1 — raw color ramps named by hue + lightness (50 lightest, 900 darkest). Every ramp is monotonic in perceptual L* with a stable hue; light steps (50-200) are pastel background tints, mid steps (500-700) are readable foregrounds. Meaningless on their own; semantic tokens give them roles.",

    "gray": {
      "$type": "color",
      "$description": "Neutral grey (hue stripped, C*≈0) — every surface, border, and ink tone. Was 'barely-warm' but the warm hue put a yellow film over the whole editor; neutralised at identical lightness so all contrasts hold. base (50) is the single shared environment background for nvim, terminal and zellij; a soft off-white (not stark) so it reads calm, not glary.",
      "50":  { "$value": "#EEEEEE" },
      "100": { "$value": "#E5E5E5" },
      "200": { "$value": "#D9D9D9" },
      "300": { "$value": "#C9C9C9" },
      "400": { "$value": "#B4B4B4" },
      "500": { "$value": "#696969" },
      "600": { "$value": "#575757" },
      "700": { "$value": "#454545" },
      "800": { "$value": "#353535" },
      "900": { "$value": "#191919" }
    },

    "red": {
      "$type": "color",
      "$description": "Errors, deletions, and the warm mode-accent.",
      "50":  { "$value": "#F1EBE9" },
      "100": { "$value": "#F3E0DC" },
      "200": { "$value": "#EDCFCB" },
      "300": { "$value": "#C29E98" },
      "400": { "$value": "#B37F77" },
      "500": { "$value": "#B2422E" },
      "600": { "$value": "#AD2F22" },
      "700": { "$value": "#7F4038" },
      "800": { "$value": "#64312A" },
      "900": { "$value": "#431F1B" }
    },

    "green": {
      "$type": "color",
      "$description": "Strings, additions, success.",
      "50":  { "$value": "#EDF0EC" },
      "100": { "$value": "#D9EADC" },
      "200": { "$value": "#C6DEC9" },
      "300": { "$value": "#9BB496" },
      "400": { "$value": "#7EA079" },
      "500": { "$value": "#628A5D" },
      "600": { "$value": "#417445" },
      "700": { "$value": "#1D6930" },
      "800": { "$value": "#2F4E31" },
      "900": { "$value": "#1D321F" }
    },

    "amber": {
      "$type": "color",
      "$description": "Warnings, search highlights, changed hunks.",
      "50":  { "$value": "#F4F1E7" },
      "100": { "$value": "#F3ECCA" },
      "200": { "$value": "#EEDEA5" },
      "300": { "$value": "#E2C97D" },
      "400": { "$value": "#B8A376" },
      "500": { "$value": "#987431" },
      "600": { "$value": "#985D00" },
      "700": { "$value": "#68532B" },
      "800": { "$value": "#4D3E1D" },
      "900": { "$value": "#322811" }
    },

    "blue": {
      "$type": "color",
      "$description": "Info, links, functions, cool-tinted surfaces.",
      "50":  { "$value": "#EFF1F2" },
      "100": { "$value": "#E1E5E8" },
      "200": { "$value": "#C7CFD6" },
      "300": { "$value": "#A5B3C0" },
      "400": { "$value": "#8496A9" },
      "500": { "$value": "#3A6999" },
      "600": { "$value": "#346392" },
      "700": { "$value": "#3F546B" },
      "800": { "$value": "#2E4154" },
      "900": { "$value": "#1C2B39" }
    },

    "cyan": {
      "$type": "color",
      "$description": "Cyan accent ramp (terminal cyan channel).",
      "50":  { "$value": "#E9EDEE" },
      "100": { "$value": "#D2DBDD" },
      "200": { "$value": "#ADC0C3" },
      "300": { "$value": "#86A5AA" },
      "400": { "$value": "#678B91" },
      "500": { "$value": "#3D747E" },
      "600": { "$value": "#186974" },
      "700": { "$value": "#365259" },
      "800": { "$value": "#273F45" },
      "900": { "$value": "#192C30" }
    },

    "violet": {
      "$type": "color",
      "$description": "Blue-violet — constants.",
      "50":  { "$value": "#ECEBF0" },
      "100": { "$value": "#D5D3DE" },
      "200": { "$value": "#B5AFC9" },
      "300": { "$value": "#9890B8" },
      "400": { "$value": "#7E74A9" },
      "500": { "$value": "#685F9C" },
      "600": { "$value": "#554B84" },
      "700": { "$value": "#463D6E" },
      "800": { "$value": "#342D54" },
      "900": { "$value": "#201C35" }
    },

    "plum": {
      "$type": "color",
      "$description": "Red-violet — terminal magenta channel.",
      "50":  { "$value": "#ECE9EC" },
      "100": { "$value": "#D4CBD4" },
      "200": { "$value": "#B9A8BA" },
      "300": { "$value": "#9F86A1" },
      "400": { "$value": "#876887" },
      "500": { "$value": "#705275" },
      "600": { "$value": "#604365" },
      "700": { "$value": "#513956" },
      "800": { "$value": "#402E45" },
      "900": { "$value": "#2E1E32" }
    }
  },

  "semantic": {
    "$description": "Layer 2 — roles in the Ergo Light language. Tool-agnostic: these describe meaning (a surface, an error, a string), never a tool. Every value is an alias into a primitive ramp so the whole system re-tunes from Layer 1.",

    "surface": {
      "$type": "color",
      "base":        { "$value": "{primitive.gray.50}",  "$description": "shared background for editor, terminal and zellij — soft neutral paper" },
      "raised":      { "$value": "{primitive.gray.100}", "$description": "panels, bars, floats, tab bar" },
      "code":        { "$value": "{primitive.gray.100}", "$description": "inline & fenced code bg" },
      "cursorline":  { "$value": "{primitive.gray.200}", "$description": "current-line highlight — stepped to gray.200 so it is actually visible on paper" },
      "column":      { "$value": "{primitive.gray.100}", "$description": "colorcolumn / cursorcolumn" },
      "ruler":       { "$value": "{primitive.gray.100}", "$description": "ruler background" },
      "popup":       { "$value": "{primitive.gray.100}", "$description": "popup / telescope bg — one step off base so it reads as a layer, not just a border" },
      "popupHeader": { "$value": "{primitive.gray.200}", "$description": "popup title bar" },
      "tile":        { "$value": "{primitive.gray.300}", "$description": "multiplexer bar/tile shade" }
    },

    "border": {
      "$type": "color",
      "default": { "$value": "{primitive.gray.300}", "$description": "splits, scrollbar, borders" }
    },

    "text": {
      "$type": "color",
      "primary":   { "$value": "{primitive.gray.800}", "$description": "body text / default fg — soft neutral dark (~10:1), calm not harsh" },
      "secondary": { "$value": "{primitive.gray.600}", "$description": "secondary / status text" },
      "muted":     { "$value": "{primitive.gray.500}", "$description": "comments, hints, line numbers" }
    },

    "accent": {
      "$type": "color",
      "string":   { "$value": "{primitive.green.600}",  "$description": "string literals / git add" },
      "constant": { "$value": "{primitive.violet.500}", "$description": "constants, numbers, booleans" },
      "function": { "$value": "{primitive.blue.500}",   "$description": "function names" },
      "link":     { "$value": "{primitive.blue.600}",   "$description": "links / urls" },
      "warm":     { "$value": "{primitive.red.500}",    "$description": "warm mode-accent (e.g. zellij PANE)" }
    },

    "status": {
      "$type": "color",
      "error":   { "$value": "{primitive.red.600}",   "$description": "errors" },
      "warning": { "$value": "{primitive.amber.600}", "$description": "warnings" },
      "info":    { "$value": "{primitive.blue.600}",  "$description": "info" },
      "hint":    { "$value": "{primitive.gray.500}",  "$description": "hints" },
      "success": { "$value": "{primitive.green.600}", "$description": "success" }
    },

    "selection": {
      "$type": "color",
      "primary":   { "$value": "{primitive.blue.200}", "$description": "active selection" },
      "secondary": { "$value": "{primitive.gray.200}", "$description": "inactive / menu selection" },
      "match":     { "$value": "{primitive.blue.100}", "$description": "matched pair / reference" }
    },

    "search": {
      "$type": "color",
      "soft":   { "$value": "{primitive.amber.200}", "$description": "search match bg — stepped up so matches read on paper" },
      "active": { "$value": "{primitive.amber.300}", "$description": "current search / incsearch" }
    },

    "comment": {
      "$type": "color",
      "fg":   { "$value": "{primitive.gray.600}",  "$description": "comment foreground — darker than muted text: comments are important signal, meant to be read, not skimmed past" },
      "bg":   { "$value": "{primitive.amber.100}", "$description": "normal comment band — soft light yellow" },
      "high": { "$value": "{primitive.amber.200}", "$description": "high-priority comment markers (TODO/FIXME/WARNING/NOTE) — the deeper 'attention' amber, shared with diff-changed lines, so must-see notes out-shout ordinary comments" }
    },

    "doc": {
      "$type": "color",
      "fg":      { "$value": "{primitive.gray.700}", "$description": "documentation text" },
      "bg":      { "$value": "{primitive.blue.50}",  "$description": "documentation background" },
      "quote":   { "$value": "{primitive.blue.50}",  "$description": "blockquote background" },
      "heading": { "$value": "{primitive.gray.800}", "$description": "documentation heading" }
    },

    "diff": {
      "$type": "color",
      "add":      { "$value": "{primitive.green.100}", "$description": "added lines — pastel tint, visible on paper" },
      "addText":  { "$value": "{primitive.green.200}", "$description": "word-level emphasis inside an added line (delta plus-emph / nvim DiffText) — one gentle step above the line tint, not a hot block" },
      "change":     { "$value": "{primitive.amber.200}", "$description": "changed/modified lines (nvim DiffChange) — the 'attention' amber (deeper than the normal comment band). Add/delete stay rose/mint (git-standard red/green); changed is amber. The comment band is suppressed inside diffs so this never nests with comment yellow." },
      "changeText": { "$value": "{primitive.amber.200}", "$description": "uniform with the changed line — no darker word-patch." },
      "delete":   { "$value": "{primitive.red.100}",   "$description": "deleted lines" },
      "deleteText": { "$value": "{primitive.red.200}", "$description": "word-level emphasis inside a deleted line (delta minus-emph)" },
      "conflict": { "$value": "{primitive.red.100}",   "$description": "conflict markers" }
    },

    "cursor": {
      "$type": "color",
      "primary":   { "$value": "{primitive.gray.900}", "$description": "primary cursor block — kept near-black so the caret stays easy to spot" },
      "secondary": { "$value": "{primitive.gray.500}", "$description": "secondary cursor" }
    },

    "terminal": {
      "$description": "The ANSI palette is a role a terminal plays, not a tool. Muted on purpose vs the editor accents. On a light theme the 'white' channels are inherently low-contrast (meant for fills, not readable text): white=gray.500 stays legible, bright.white=gray.400 is a soft fill.",
      "ansi": {
        "$type": "color",
        "black":   { "$value": "{primitive.gray.900}" },
        "red":     { "$value": "{primitive.red.600}" },
        "green":   { "$value": "{primitive.green.700}" },
        "yellow":  { "$value": "{primitive.amber.600}" },
        "blue":    { "$value": "{primitive.blue.600}" },
        "magenta": { "$value": "{primitive.plum.600}" },
        "cyan":    { "$value": "{primitive.cyan.600}" },
        "white":   { "$value": "{primitive.gray.500}" }
      },
      "bright": {
        "$type": "color",
        "black":   { "$value": "{primitive.gray.700}" },
        "red":     { "$value": "{primitive.red.500}" },
        "green":   { "$value": "{primitive.green.600}" },
        "yellow":  { "$value": "{primitive.amber.500}" },
        "blue":    { "$value": "{primitive.blue.500}" },
        "magenta": { "$value": "{primitive.plum.500}" },
        "cyan":    { "$value": "{primitive.cyan.500}" },
        "white":   { "$value": "{primitive.gray.400}" }
      }
    }
  }
}
