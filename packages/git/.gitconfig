[user]
  name = Evgenii Serebriakov
  email = 14977072+e-serebriakov@users.noreply.github.com
  signingkey = ~/.ssh/sign.pub

[core]
  autocrlf = input
  untrackedCache = true

; Use SSH for all GitHub traffic. On a new machine, set up SSH keys before lazy.nvim and zsh plugins clone.
[url "git@github.com:"]
  insteadOf = https://github.com/

[branch]
  sort = -committerdate

[column]
  ui = auto

[init]
  defaultBranch = main

[gpg]
  format = ssh

[commit]
  gpgsign = true
  verbose = true

[push]
  autosetupremote = true
  default = current
  followtags = true
  useForceIfIncludes = true

[pull]
  rebase = true

[rebase]
  autoStash = true
  ; Leave updateRefs unset: Git Town rebases without --no-update-refs.

[fetch]
  prune = true
  pruneTags = true

[merge]
  conflictStyle = zdiff3

[rerere]
  enabled = true

[diff]
  algorithm = histogram
  colorMoved = true
  indentHeuristic = true
  renames = copies

[help]
  autocorrect = prompt

[gpg "ssh"]
  allowedSignersFile = ~/.ssh/allowed_signers

[tag]
  gpgSign = true
  sort = version:refname

; Add the stack lineage to each proposal that git town propose creates.
[git-town]
  proposal-breadcrumb = stacks
