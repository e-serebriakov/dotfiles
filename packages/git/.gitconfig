[user]
  name = Evgenii Serebriakov
  email = 14977072+e-serebriakov@users.noreply.github.com
  signingkey = ~/.ssh/sign.pub
    
[core]
  autocrlf = input
  pager = delta

[interactive]
  diffFilter = delta --color-only

[delta]
  navigate = true
  side-by-side = true
  line-numbers = true
  ; Ergo Light — matches nvim ergo_light diff colors
  light = true
  syntax-theme = GitHub
  plus-style = "syntax #E9F2EA"
  plus-emph-style = "syntax #D3E7D6"
  minus-style = "syntax #F6E9E8"
  minus-emph-style = "syntax #EED4D2"
  hunk-header-style = "#6B7076"
  hunk-header-decoration-style = "#DDDDDA" ul
  file-style = "#121212" bold
  file-decoration-style = "#DDDDDA" ul
  line-numbers-minus-style = "#B2473F"
  line-numbers-plus-style = "#4F9A5A"
  line-numbers-zero-style = "#6B7076"

[url "git@github.com:"]
  insteadOf = https://github.com/

[credential]
  helper = store

[color]
  diff   = auto
  status = auto
  branch = auto

[branch]
  autosetuprebase = always

[init]
  defaultBranch = main

[gpg]
  format = ssh

[commit]
  gpgsign = true

[push]
  autosetupremote = true
  default = current
  followtags = true

[pull]
  default = current

[rebase]
  autoStash = true

[rerere]
  enabled = true

[diff]
  algorithm = histogram
  colorMoved = true
  indentHeuristic = true

[help]
  autocorrect = 5

[gpg "ssh"]
  allowedSignersFile = ~/.ssh/allowed_signers

[tag]
  gpgSign = true

[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
