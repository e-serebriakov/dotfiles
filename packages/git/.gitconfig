[user]
  name = Evgenii Serebriakov
  email = 14977072+e-serebriakov@users.noreply.github.com
  signingkey = ~/.ssh/sign.pub
    
[core]
  autocrlf = input
  pager = delta

[interactive]
  diffFilter = delta --color-only

[delta]
  navigate = true
  side-by-side = true
  line-numbers = true
  light = true

; Ergo Light delta colors — GENERATED from theme/ergo-light.tokens.json (gitignored).
; Edit the tokens + run `cd ~/dotfiles/theme && bb -m generate`, not this include.
[include]
  path = ~/.config/delta/ergo-light.gitconfig

[url "git@github.com:"]
  insteadOf = https://github.com/

[color]
  diff   = auto
  status = auto
  branch = auto

[branch]
  autosetuprebase = always

[init]
  defaultBranch = main

[gpg]
  format = ssh

[commit]
  gpgsign = true

[push]
  autosetupremote = true
  default = current
  followtags = true

[pull]
  default = current

[rebase]
  autoStash = true

[rerere]
  enabled = true

[diff]
  algorithm = histogram
  colorMoved = true
  indentHeuristic = true

[help]
  autocorrect = 5

[gpg "ssh"]
  allowedSignersFile = ~/.ssh/allowed_signers

[tag]
  gpgSign = true
