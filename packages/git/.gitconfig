[user]
  name = Evgenii Serebriakov
  email = 14977072+e-serebriakov@users.noreply.github.com
  signingkey = ~/.ssh/sign.pub
    
[core]
  autocrlf = input

[url "git@github.com:"]
  insteadOf = https://github.com/

[credential]
  helper = store

[color]
  diff   = auto
  status = auto
  branch = auto

[branch]
  autosetuprebase = always

[init]
  defaultBranch = main

[gpg]
  format = ssh

[commit]
  gpgsign = true

[push]
  autosetupremote = true
  default = current
  followtags = true

[pull]
  default = current

[rebase]
  autoStash = true

[rerere]
  enabled = true

[diff]
  algorithm = histogram
  colorMoved = true
  indentHeuristic = true

[help]
  autocorrect = 5

[gpg "ssh"]
  allowedSignersFile = ~/.ssh/allowed_signers

[tag]
  gpgSign = true

