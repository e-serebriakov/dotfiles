[user]
  name = Evgenii Serebriakov
  email = 14977072+e-serebriakov@users.noreply.github.com
  signingkey = ~/.ssh/sign.pub
    
[core]
  autocrlf = input
  pager = delta

[interactive]
  diffFilter = delta --color-only

[delta]
  navigate = true
  side-by-side = true
  line-numbers = true
  light = true

; Ergo Light delta colors — GENERATED from theme/ergo-light.tokens.json (gitignored).
; Edit the tokens + run `bb -m generate` in the repo's theme/, not this include.
[include]
  path = ~/.config/delta/ergo-light.gitconfig

; Push over SSH, but keep fetching over anonymous https so clones work before
; SSH keys are set up (lazy.nvim, zsh plugins).
[url "git@github.com:"]
  pushInsteadOf = https://github.com/

[color]
  diff   = auto
  status = auto
  branch = auto

[branch]
  sort = -committerdate

[init]
  defaultBranch = main

[gpg]
  format = ssh

[commit]
  gpgsign = true

[push]
  autosetupremote = true
  default = current
  followtags = true

[pull]
  rebase = true

[rebase]
  autoStash = true
  ; updateRefs deliberately unset: git town rebases without --no-update-refs.

[fetch]
  prune = true

[merge]
  conflictStyle = zdiff3

[rerere]
  enabled = true

[diff]
  algorithm = histogram
  colorMoved = true
  indentHeuristic = true

[help]
  autocorrect = 5

[gpg "ssh"]
  allowedSignersFile = ~/.ssh/allowed_signers

[tag]
  gpgSign = true
