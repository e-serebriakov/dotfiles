[user]
  name = Evgenii Serebriakov
  email = 14977072+e-serebriakov@users.noreply.github.com
  signingkey = ~/.ssh/sign.pub
    
[core]
  autocrlf = input
  pager = delta

[interactive]
  diffFilter = delta --color-only

[delta]
  navigate = true
  side-by-side = true
  line-numbers = true
  light = true

; Generated delta colors from the active theme/*.tokens.json. Git ignores the output file.
; Edit the tokens. Then run bb -m generate in theme/. Do not edit the generated file.
[include]
  path = ~/.config/delta/baked.gitconfig

; Use SSH for all GitHub traffic. On a new machine, set up SSH keys before lazy.nvim and zsh plugins clone.
[url "git@github.com:"]
  insteadOf = https://github.com/

[color]
  diff   = auto
  status = auto
  branch = auto

[branch]
  sort = -committerdate

[init]
  defaultBranch = main

[gpg]
  format = ssh

[commit]
  gpgsign = true

[push]
  autosetupremote = true
  default = current
  followtags = true

[pull]
  rebase = true

[rebase]
  autoStash = true
  ; Leave updateRefs unset: Git Town rebases without --no-update-refs.

[fetch]
  prune = true

[merge]
  conflictStyle = zdiff3

[rerere]
  enabled = true

[diff]
  algorithm = histogram
  colorMoved = true
  indentHeuristic = true

[help]
  autocorrect = 5

[gpg "ssh"]
  allowedSignersFile = ~/.ssh/allowed_signers

[tag]
  gpgSign = true
