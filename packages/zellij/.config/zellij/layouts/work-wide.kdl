// Wide-screen variant of the work layout — same tabs, but the work column
// is capped at 180 cols and centered between inert blank margins so lines
// stay readable on big/ultrawide monitors.
//
// The fixed size=180 pane means this layout only fits on terminals wider
// than ~200 cols — on narrower ones zellij drops the whole tab. `dev`
// picks this layout automatically when $COLUMNS is large enough;
// otherwise it falls back to work.kdl.
//
// For quick commands without leaving the work tab: Alt+f (floating pane)

layout {
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="zellij:tab-bar"
        }
        children
        pane size=2 borderless=true {
            plugin location="zellij:status-bar"
        }
    }

    tab name="work" focus=true {
        // The `command="cat"` panes are inert margins (cat blocks on stdin,
        // draws nothing). Tweak the column width via `size=180`.
        pane split_direction="vertical" {
            pane borderless=true command="cat"        // left margin (inert)
            pane size=180 stacked=true {              // centered work column, capped at 180 cols
                pane name="editor" focus=true command="nvim" args="."
                pane name="claude"
            }
            pane borderless=true command="cat"        // right margin (inert)
        }
    }
    tab name="feedback" {
        pane split_direction="vertical" {
            pane name="logs"
            pane name="shell"
        }
    }
}
