// Per-service layout template.
// Usage:
//   1. Copy: cp svc-template.kdl svc-<name>.kdl
//   2. Set the cwd option on panes to your service root (e.g., cwd "/home/user/code/services/auth")
//   3. Add start_suspended false and command to auto-launch processes per pane
//
// Example pane with cwd and startup command:
//   pane cwd="/home/user/code/services/auth" {
//       command "nvim"
//       args "."
//   }

layout {
    // Top: editor + claude side by side
    pane split_direction="vertical" size="75%" {
        // Replace cwd with the service root path
        pane size="70%" name="editor" {
            // cwd "/path/to/service"
            // command "nvim"
            // args "."
        }
        pane size="30%" name="claude" {
            // cwd "/path/to/service"
        }
    }

    // Bottom: feedback layer
    pane split_direction="vertical" size="25%" {
        pane name="tests" {
            // cwd "/path/to/service"
            // command "bash"
            // args "-c" "npm test --watch"
        }
        pane name="logs" {
            // cwd "/path/to/service"
            // command "bash"
            // args "-c" "tail -f logs/app.log"
        }
    }

    // Navigation hint bar
    pane size=2 borderless=true {
        plugin location="zellij:status-bar"
    }
}
