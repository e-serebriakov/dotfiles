// This project layout starts in the shell's current directory.
// Press Alt+f for a floating pane in the work tab.
// Press Alt+/ to show keybindings for the current mode.
// Start with dev <project>.

layout {
    default_tab_template {
        children
        pane size=1 borderless=true {
            plugin location="zellij:compact-bar" {
                tooltip "Alt /"
            }
        }
    }

    tab name="work" focus=true {
        pane split_direction="vertical" {
            pane name="editor" focus=true command="nvim" args="."
            pane name="agent"
        }
    }
    tab name="feedback" {
        pane split_direction="vertical" {
            pane name="logs"
            pane name="shell"
        }
    }
}
