// Standard project layout — inherits cwd from the shell
//
// For quick commands without leaving the work tab: Alt+f (floating pane)
//
// Launch via: dev <project>

layout {
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="zellij:tab-bar"
        }
        children
        pane size=2 borderless=true {
            plugin location="zellij:status-bar"
        }
    }

    tab name="work" focus=true {
        pane stacked=true {
            pane name="editor" focus=true command="nvim" args="."
            pane name="claude"
        }
    }
    tab name="feedback" {
        pane split_direction="vertical" {
            pane name="logs"
            pane name="shell"
        }
    }
}
