// Project layout; starts in the shell's current directory.
// Press Alt+f for a floating pane in the work tab.
// Start with dev <project>.

layout {
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="zellij:tab-bar"
        }
        children
        pane size=2 borderless=true {
            plugin location="zellij:status-bar"
        }
    }

    tab name="work" focus=true {
        pane split_direction="vertical" {
            pane name="editor" focus=true command="nvim" args="."
            pane name="agent"
        }
    }
    tab name="feedback" {
        pane split_direction="vertical" {
            pane name="logs"
            pane name="shell"
        }
    }
}
