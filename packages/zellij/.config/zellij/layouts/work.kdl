// Standard project layout — inherits cwd from the shell
// Tab 1 "work":     editor + claude stacked (full width each)
// Tab 2 "feedback": shell + logs side by side
//
// For quick commands without leaving the work tab: Alt+f (floating pane)
//
// Launch via: dev <project>

layout {
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="zellij:tab-bar"
        }
        children
        pane size=2 borderless=true {
            plugin location="zellij:status-bar"
        }
    }

    tab name="work" focus=true {
        // Centered, width-capped work column with inert blank margins.
        // On big/ultrawide monitors this keeps lines readable and the active
        // content near the middle instead of the bottom-left corner.
        // Tweak the width via `size=180`; the `command="cat"` panes are inert
        // margins (cat blocks on stdin, draws nothing).
        pane split_direction="vertical" {
            pane borderless=true command="cat"        // left margin (inert)
            pane size=180 stacked=true {              // centered work column, capped at 180 cols
                pane name="editor" focus=true command="nvim" args="."
                pane name="claude"
            }
            pane borderless=true command="cat"        // right margin (inert)
        }
    }
    tab name="feedback" {
        pane split_direction="vertical" {
            pane name="logs"
            pane name="shell"
        }
    }
}
