// Main agentic coding layout
// Tab 1 "work":     editor + claude stacked (full width each)
// Tab 2 "feedback": tests + logs split side by side
//
// Start with: zellij --layout ~/.config/zellij/layouts/work.kdl

layout {
    tab name="work" focus=true {
        pane stacked=true {
            pane name="editor" focus=true
            pane name="claude"
        }
    }
    tab name="feedback" {
        pane split_direction="vertical" {
            pane name="tests"
            pane name="logs"
        }
    }

    pane size=1 borderless=true {
        plugin location="zellij:tab-bar"
    }
    pane size=2 borderless=true {
        plugin location="zellij:status-bar"
    }
}
