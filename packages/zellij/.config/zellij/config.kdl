// Zellij's default keybindings, plus Alt navigation in locked mode.
// Zellij starts locked (default_mode below); Ctrl+g toggles locked/normal.
keybinds {
    locked {
        bind "Alt h" { MoveFocusOrTab "Left"; }
        bind "Alt l" { MoveFocusOrTab "Right"; }
        bind "Alt j" { MoveFocus "Down"; }
        bind "Alt k" { MoveFocus "Up"; }
        bind "Alt f" { ToggleFloatingPanes; }
        bind "Alt n" { NewPane; }
    }
    // Esc in normal mode re-locks, so Ctrl keys go back to Neovim and the shell.
    normal {
        bind "Esc" { SwitchToMode "Locked"; }
    }
}

// Plugin aliases select plugin implementations. Restart Zellij after changes.
plugins {
    about location="zellij:about"
    compact-bar location="zellij:compact-bar"
    configuration location="zellij:configuration"
    filepicker location="zellij:strider" {
        cwd "/"
    }
    plugin-manager location="zellij:plugin-manager"
    session-manager location="zellij:session-manager"
    status-bar location="zellij:status-bar"
    strider location="zellij:strider"
    tab-bar location="zellij:tab-bar"
    welcome-screen location="zellij:session-manager" {
        welcome_screen true
    }
}

theme "baked"
// Start locked so Ctrl keys reach Neovim or the shell. Ctrl+g unlocks Zellij.
// Actions return to normal mode, not locked; press Ctrl+g to lock again.
default_mode "locked"
// No red frame on the pane under the mouse; the highlight only marks an active mode.
mouse_hover_effects false
default_shell "zsh"
default_layout "work"
show_release_notes false

// Theme "baked" is defined in themes/baked.kdl, generated from
// the active theme/*.tokens.json (see theme/generate.clj).
