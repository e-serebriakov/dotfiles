.DS_Store
/.claude
.cc-writes/

.lsp

.nvimlog
nvim.log

__pycache__/

# Karabiner writes these into its directory, which Stow links to the repository.
packages/karabiner/.config/karabiner/assets/
packages/karabiner/.config/karabiner/automatic_backups/

.nrepl-port
**/.clj-kondo/.cache/
**/.clj-kondo/imports/

# Generated theme files — build artifacts of theme/generate.clj.
# Edit theme/*.tokens.json. Setup regenerates the output files.
packages/**/baked*
# The nvim colorscheme loader and its :colorscheme entry point are hand-written.
!packages/nvim/.config/nvim/lua/colorschemes/baked.lua
!packages/nvim/.config/nvim/colors/baked.lua
